# Xcode / Swift
#
# Ignore all user-specific and build-related files.
# Keep only the project and your source code.

# User settings
*.xcuserdata/
*.xcuserdatad/
*.xcconfig

# Build products
build/
DerivedData/
*.o
*.linkfilelist
*.swiftsourceinfo

# Indexing & symbol caches
*.xcactivitylog
*.xccheckout
*.xcscmblueprint

# Swift Package Manager
/.build/
/.swiftpm/
Package.resolved

# CocoaPods
Pods/
*.xcworkspace
Podfile.lock

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# Generated by Xcode
*.hmap
*.ipa
*.xcarchive
*.app
*.dSYM
*.framework

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Misc
*.DS_Store
*.swp
*.tmp
*.log
*.local

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Temporary files
*.sw?
*~.nib

# Claude
.claude/
